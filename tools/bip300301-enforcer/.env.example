# Selects the matching bitcoin-rs and BIP300/301 enforcer network.
BITCOIN_RS_NETWORK=drynet4

# JSON-RPC is published to 127.0.0.1 on the Docker host.
BITCOIN_RS_RPC_PORT=8332
BITCOIN_RS_RPC_USER=
BITCOIN_RS_RPC_PASSWORD=

# P2P is published on all Docker host interfaces so other nodes can connect.
BITCOIN_RS_P2P_PORT=8333

# Optional indexes and wallet protocol services are disabled by default.
BITCOIN_RS_TXINDEX=false
BITCOIN_RS_ELECTRUM_BIND=

# Runtime tracing filter.
BITCOIN_RS_LOG_LEVEL=debug

ENFORCER_GRPC_PORT=50051
ENFORCER_RPC_PORT=8122
