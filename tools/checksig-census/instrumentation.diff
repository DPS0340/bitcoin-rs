+// btck_bare_verify_bench: mode 0 = CPubKey::Verify (parse pubkey + lax DER + normalize + verify)
+int btck_bare_verify_bench(const btck_bare_input* inputs, uint64_t count,
+                            uint32_t warmup_rounds, uint32_t timed_rounds,
+                            uint32_t mode, btck_bare_result* result)
+{
+    if (mode != 0 || inputs == nullptr || result == nullptr || count == 0) return -1;
+    if (timed_rounds == 0 || timed_rounds > 64) return -1;
+
+    // Prebuild CPubKey, DER vectors, and uint256 outside timing
+    std::vector<CPubKey> pubkeys;
+    std::vector<std::vector<unsigned char>> sigs;
+    std::vector<uint256> hashes;
+    pubkeys.reserve(count);
+    sigs.reserve(count);
+    hashes.reserve(count);
+
+    for (uint64_t i = 0; i < count; i++) {
+        const auto& inp = inputs[i];
+        if (inp.der_len > 72 || inp.pubkey_len > 65 || inp.expected > 1) return -1;
+        pubkeys.emplace_back(inp.pubkey, inp.pubkey + inp.pubkey_len);
+        sigs.emplace_back(inp.der_sig, inp.der_sig + inp.der_len);
+        uint256 h;
+        std::memcpy(h.begin(), inp.sighash, 32);
+        hashes.push_back(h);
+    }
+
+    // Mandatory untimed correctness pass
+    uint64_t ok_count = 0;
+    uint64_t mismatches = 0;
+    uint64_t first_mismatch = UINT64_MAX;
+    for (uint64_t i = 0; i < count; i++) {
+        bool ok = pubkeys[i].Verify(hashes[i], sigs[i]);
+        if (ok) ok_count++;
+        bool expected_ok = (inputs[i].expected != 0);
+        if (ok != expected_ok) {
+            if (mismatches == 0) first_mismatch = i;
+            mismatches++;
+        }
+    }
+
+    // Warmup rounds (untimed)
+    for (uint32_t r = 0; r < warmup_rounds; r++) {
+        for (uint64_t i = 0; i < count; i++) {
+            pubkeys[i].Verify(hashes[i], sigs[i]);
+        }
+    }
+
+    // Timed rounds - no I/O, no counters, no locks
+    uint64_t attempts = count * timed_rounds;
+    for (uint32_t r = 0; r < timed_rounds; r++) {
+        auto start = std::chrono::steady_clock::now();
+        for (uint64_t i = 0; i < count; i++) {
+            pubkeys[i].Verify(hashes[i], sigs[i]);
+        }
+        auto end = std::chrono::steady_clock::now();
+        result->round_ns[r] = std::chrono::duration_cast<std::chrono::nanoseconds>(end - start).count();
+    }
+
+    result->attempts = attempts;
+    result->rounds = timed_rounds;
+    result->mismatches = mismatches;
+    result->first_mismatch = first_mismatch;
+    result->ok_count = ok_count;
+
+    return 0;
+}
