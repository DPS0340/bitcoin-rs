# ecash drynet4 uses Bitcoin mainnet history with its own P2P network.
BITCOIN_RS_NETWORK=mainnet
BITCOIN_RS_CONNECT=drynet4.drivechain.dev:8533
BITCOIN_RS_P2P_MAGIC=eca5d404
ENFORCER_NETWORK_PRESET=drynet4

# JSON-RPC is published to 127.0.0.1 on the Docker host.
BITCOIN_RS_RPC_PORT=8332
BITCOIN_RS_RPC_USER=
BITCOIN_RS_RPC_PASSWORD=

# P2P is published on all Docker host interfaces so other nodes can connect.
BITCOIN_RS_P2P_PORT=8533

# Runtime tracing filter.
BITCOIN_RS_LOG_LEVEL=info

ENFORCER_GRPC_PORT=50051
ENFORCER_RPC_PORT=8122
