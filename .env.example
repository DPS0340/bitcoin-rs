# JSON-RPC is published to 127.0.0.1 on the Docker host.
BITCOIN_RS_RPC_PORT=18443
BITCOIN_RS_RPC_USER=
BITCOIN_RS_RPC_PASSWORD=

# P2P is published on all Docker host interfaces so other nodes can connect.
BITCOIN_RS_P2P_PORT=18444

# Optional fixed outbound peer. Hostnames and numeric IP addresses are accepted.
# BITCOIN_RS_CONNECT=example.com:18444

# Runtime tracing filter.
BITCOIN_RS_LOG_LEVEL=info

ENFORCER_GRPC_PORT=50051
ENFORCER_RPC_PORT=8122
